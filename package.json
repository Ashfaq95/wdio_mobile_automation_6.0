{
  "name": "mobile-automation",
  "version": "1.0.0",
  "description": "WebdriverIO + Appium mobile test automation for Android & iOS native apps",
  "scripts": {
    "test": "npx wdio run config/wdio.conf.ts",
    "test:android": "DEVICE=android-device-1 npx wdio run config/wdio.conf.ts",
    "test:ios": "DEVICE=ios-device-1 npx wdio run config/wdio.conf.ts",
    "test:suite": "npx wdio run config/wdio.conf.ts --suite",
    "test:spec": "npx wdio run config/wdio.conf.ts --spec",
    "test:grep": "npx wdio run config/wdio.conf.ts --mochaOpts.grep",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open"
  },
  "dependencies": {
    "@wdio/allure-reporter": "^9.27.1",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "allure-commandline": "^2.41.0",
    "appium": "^2.0.0",
    "appium-uiautomator2-driver": "^3.0.0",
    "appium-xcuitest-driver": "^7.0.0",
    "axios": "^1.7.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
